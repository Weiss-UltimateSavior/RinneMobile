<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_bg">

    <ScrollView
        android:id="@+id/toolboxScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:paddingBottom="66dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="25dp"
            android:paddingEnd="20dp"
            android:paddingBottom="25dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_toolbox_title"
                android:textColor="@color/launcher_text_color"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- 单一网格按顺序排布：一行固定 3 格，末行不足 3 格时用非交互占位格留空 -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:alignmentMode="alignMargins"
                android:columnCount="3"
                android:useDefaultMargins="false">

                <LinearLayout
                    android:id="@+id/toolWinlator"
                    style="@style/LauncherToolboxItem">

                    <ImageView
                        style="@style/LauncherToolboxIcon"
                        android:contentDescription="winlator"
                        android:src="@drawable/launcher_tool_icon_winlator" />

                    <TextView
                        style="@style/LauncherToolboxTitle"
                        android:text="winlator" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toolGaishi"
                    style="@style/LauncherToolboxItem">

                    <ImageView
                        style="@style/LauncherToolboxIcon"
                        android:contentDescription="@string/settings_tool_gaishi"
                        android:src="@drawable/launcher_tool_icon_gaishi" />

                    <TextView
                        style="@style/LauncherToolboxTitle"
                        android:text="@string/settings_tool_gaishi" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toolPpsspp"
                    style="@style/LauncherToolboxItem">

                    <ImageView
                        style="@style/LauncherToolboxIcon"
                        android:contentDescription="PPSSPP"
                        android:src="@drawable/launcher_tool_icon_ppsspp" />

                    <TextView
                        style="@style/LauncherToolboxTitle"
                        android:text="PPSSPP" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toolUsefulUnpack"
                    style="@style/LauncherToolboxItem">

                    <ImageView
                        style="@style/LauncherToolboxIcon"
                        android:contentDescription="usefulunpack"
                        android:src="@drawable/launcher_tool_icon_usefulunpack" />

                    <TextView
                        style="@style/LauncherToolboxTitle"
                        android:text="usefulunpack" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toolTermux"
                    style="@style/LauncherToolboxItem">

                    <ImageView
                        style="@style/LauncherToolboxIcon"
                        android:contentDescription="termux"
                        android:src="@drawable/launcher_tool_icon_termux" />

                    <TextView
                        style="@style/LauncherToolboxTitle"
                        android:text="termux" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toolShizuku"
                    style="@style/LauncherToolboxItem">

                    <ImageView
                        style="@style/LauncherToolboxIcon"
                        android:contentDescription="shizuku"
                        android:src="@drawable/launcher_tool_icon_shizuku" />

                    <TextView
                        style="@style/LauncherToolboxTitle"
                        android:text="shizuku" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toolLunabox"
                    style="@style/LauncherToolboxItem">

                    <ImageView
                        style="@style/LauncherToolboxIcon"
                        android:contentDescription="LunaBox"
                        android:src="@drawable/launcher_tool_icon_lunabox" />

                    <TextView
                        style="@style/LauncherToolboxTitle"
                        android:text="LunaBox" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toolAzahar"
                    style="@style/LauncherToolboxItem">

                    <ImageView
                        style="@style/LauncherToolboxIcon"
                        android:contentDescription="AzaharPlus"
                        android:src="@drawable/launcher_tool_icon_azahar" />

                    <TextView
                        style="@style/LauncherToolboxTitle"
                        android:text="AzaharPlus" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toolArmsx3"
                    style="@style/LauncherToolboxItem">

                    <ImageView
                        style="@style/LauncherToolboxIcon"
                        android:contentDescription="ARMSX3"
                        android:src="@drawable/launcher_tool_icon_armsx3" />

                    <TextView
                        style="@style/LauncherToolboxTitle"
                        android:text="ARMSX3" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toolEden"
                    style="@style/LauncherToolboxItem">

                    <ImageView
                        style="@style/LauncherToolboxIcon"
                        android:contentDescription="Eden"
                        android:src="@drawable/launcher_tool_icon_eden" />

                    <TextView
                        style="@style/LauncherToolboxTitle"
                        android:text="Eden" />
                </LinearLayout>

                <!-- 末行不足 3 格时空出的位子：invisible 保留 1/3 列宽与行高，避免末行工具占满整行 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:visibility="invisible" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:visibility="invisible" />

            </GridLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/toolboxBack"
        style="@style/LauncherLongActionButton"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="25dp"
        android:text="@string/settings_back"
        />
</FrameLayout>