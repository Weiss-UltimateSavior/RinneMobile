<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_bg">

    <ImageView
        android:id="@+id/launcherPortraitBackgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.apps.theme.LauncherParticleView
        android:id="@+id/launcherParticleView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/launcherFragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/bottomNavShadow"
        android:layout_width="0dp"
        android:layout_height="@dimen/launcher_default_nav_height"
        android:alpha="0.55"
        android:background="@drawable/launcher_bottom_bar_shadow"
        android:translationY="-0.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="@dimen/launcher_default_nav_height"
        android:background="@drawable/launcher_bottom_bar"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/navSelectionIndicator"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/launcher_nav_selected" />

        <LinearLayout
            android:id="@+id/bottomNavItems"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="59dp"
                android:layout_weight="1"
                android:background="@drawable/launcher_nav_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

            <ImageView
                android:id="@+id/navHomeIcon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="@string/core_home"
                android:scaleType="fitCenter"
                android:src="@drawable/launcher_nav_home" />

            <TextView
                android:id="@+id/navHomeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/core_home"
                android:textColor="@color/launcher_primary_color"
                android:textSize="10sp"
                android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navSavings"
                android:layout_width="0dp"
                android:layout_height="59dp"
                android:layout_weight="1"
                android:background="@drawable/launcher_nav_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

            <ImageView
                android:id="@+id/navSavingsIcon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="@string/core_games"
                android:scaleType="fitCenter"
                android:src="@drawable/launcher_nav_game" />

            <TextView
                android:id="@+id/navSavingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/core_games"
                android:textColor="@color/launcher_nav_muted_color"
                android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navLaunchCenter"
                android:layout_width="0dp"
                android:layout_height="71dp"
                android:layout_weight="1"
                android:clickable="true"
                android:clipChildren="false"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

            <FrameLayout
                android:id="@+id/navLaunchCenterCircle"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:background="@drawable/launcher_icon_circle_green">

                <ImageView
                    android:id="@+id/navLaunchCenterImage"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/game_center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/launcher_game_center_default" />

                <ImageView
                    android:id="@+id/navLaunchCenterText"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/game_center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/launcher_theme_rinne_def"
                    android:visibility="gone" />
            </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navCards"
                android:layout_width="0dp"
                android:layout_height="59dp"
                android:layout_weight="1"
                android:background="@drawable/launcher_nav_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

            <ImageView
                android:id="@+id/navCardsIcon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="@string/core_manage"
                android:scaleType="fitCenter"
                android:src="@drawable/launcher_nav_manage" />

            <TextView
                android:id="@+id/navCardsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/core_manage"
                android:textColor="@color/launcher_nav_muted_color"
                android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navAccount"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/launcher_nav_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

            <ImageView
                android:id="@+id/navAccountIcon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:contentDescription="@string/core_account"
                android:scaleType="fitCenter"
                android:src="@drawable/launcher_nav_account" />

            <TextView
                android:id="@+id/navAccountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/core_account"
                android:textColor="@color/launcher_nav_muted_color"
                android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/bottomNavPill"
        android:layout_width="0dp"
        android:layout_height="@dimen/launcher_bottom_nav_height"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_gravity="center"
            android:layout_marginStart="11.5dp"
            android:layout_marginEnd="11.5dp"
            android:alpha="0.55"
            android:background="@drawable/launcher_nav_pill_shadow"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="61dp"
            android:layout_gravity="center"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/launcher_nav_pill_bar"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">

            <LinearLayout
                android:id="@+id/navPillHome"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/navPillHomeIcon"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:contentDescription="@string/core_home"
                    android:src="@drawable/launcher_nav_home" />

                <TextView
                    android:id="@+id/navPillHomeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="@string/core_home"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navPillLibrary"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/navPillLibraryIcon"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:contentDescription="@string/core_games"
                    android:src="@drawable/launcher_nav_game" />

                <TextView
                    android:id="@+id/navPillLibraryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="@string/core_games"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navPillLaunchCenter"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:id="@+id/navPillLaunchCenterIcon"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:contentDescription="@string/game_center"
                    android:src="@drawable/launcher_game_center_default" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navPillManage"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/navPillManageIcon"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:contentDescription="@string/core_manage"
                    android:src="@drawable/launcher_nav_manage" />

                <TextView
                    android:id="@+id/navPillManageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="@string/core_manage"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navPillAccount"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/navPillAccountIcon"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:contentDescription="@string/core_account"
                    android:src="@drawable/launcher_nav_account" />

                <TextView
                    android:id="@+id/navPillAccountLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="@string/core_account"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <View
        android:id="@+id/bottomNavCardShadow"
        android:layout_width="0dp"
        android:layout_height="@dimen/launcher_card_nav_height"
        android:alpha="0.55"
        android:background="@drawable/launcher_bottom_bar_shadow"
        android:importantForAccessibility="no"
        android:translationY="-0.5dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/bottomNavCard"
        android:layout_width="0dp"
        android:layout_height="@dimen/launcher_card_nav_height"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/launcher_nav_card_bar">

            <View
                android:id="@+id/cardNavSelectionIndicator"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_gravity="top|start"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/cardNavItems"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp">

                <LinearLayout
                    android:id="@+id/navCardHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/navCardHomeIcon"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:contentDescription="@string/core_home"
                        android:src="@drawable/launcher_nav_home" />

                    <TextView
                        android:id="@+id/navCardHomeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/core_home"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/navCardLibrary"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/navCardLibraryIcon"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:contentDescription="@string/core_games"
                        android:src="@drawable/launcher_nav_game" />

                    <TextView
                        android:id="@+id/navCardLibraryLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/core_games"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/navCardManage"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/navCardManageIcon"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:contentDescription="@string/core_manage"
                        android:src="@drawable/launcher_nav_manage" />

                    <TextView
                        android:id="@+id/navCardManageLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/core_manage"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/navCardAccount"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/navCardAccountIcon"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:contentDescription="@string/core_account"
                        android:src="@drawable/launcher_nav_account" />

                    <TextView
                        android:id="@+id/navCardAccountLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/core_account"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
