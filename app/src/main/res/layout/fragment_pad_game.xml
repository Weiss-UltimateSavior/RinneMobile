<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/padGamePanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 右侧列表占内容区 40%，该分界线同时限制顶部搜索区。 -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/padGameListStartGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.6" />

        <FrameLayout
            android:id="@+id/padGameListViewport"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipChildren="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/padGameRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/padGameEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/pad_no_games"
                android:textColor="@color/launcher_text_muted_color"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/padGameLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/pad_loading_games"
                android:textColor="@color/launcher_text_muted_color"
                android:textSize="13sp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/padGameHeader"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@id/padGameListStartGuide"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/padAvatarContainer"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/launcher_avatar"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless">

                    <TextView
                        android:id="@+id/padAvatarInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Y"
                        android:textColor="@color/launcher_on_primary_color"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/padAvatarImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/home_user_avatar"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/padAccountName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/home_local_player"
                        android:textColor="@color/launcher_text_color"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/padAccountMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/home_local_mode"
                        android:textColor="@color/launcher_text_muted_color"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:layout_weight="1">

                <com.apps.widget.LauncherEditText
                    android:id="@+id/padSearchInput"
                    style="@style/LauncherAddGameInput"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="0dp"
                    android:hint="@string/pad_search_game_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingEnd="48dp" />

                <ImageView
                    android:id="@+id/padSearchIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:contentDescription="@string/pad_search"
                    android:focusable="true"
                    android:src="@drawable/launcher_pad_search_icon" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/padGameShortcutContainer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:padding="10dp"
            app:layout_constraintEnd_toStartOf="@id/padGameListStartGuide"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/padGameHeader">

            <FrameLayout
                android:id="@+id/padGameShortcutOne"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/pad_game_recent_card"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/padGameShowcaseImageOne"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/padGameShowcaseAddOne"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/pad_showcase_add_symbol"
                    android:textColor="@color/launcher_text_muted_color"
                    android:textSize="32sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/padGameShortcutTwo"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/pad_game_recent_card"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/padGameShowcaseImageTwo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/padGameShowcaseAddTwo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/pad_showcase_add_symbol"
                    android:textColor="@color/launcher_text_muted_color"
                    android:textSize="32sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/padGameShortcutThree"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/pad_game_recent_card"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/padGameShowcaseImageThree"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/padGameShowcaseAddThree"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/pad_showcase_add_symbol"
                    android:textColor="@color/launcher_text_muted_color"
                    android:textSize="32sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/padGameShortcutFour"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@drawable/pad_game_recent_card"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/padGameShowcaseImageFour"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/padGameShowcaseAddFour"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/pad_showcase_add_symbol"
                    android:textColor="@color/launcher_text_muted_color"
                    android:textSize="32sp" />
            </FrameLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
