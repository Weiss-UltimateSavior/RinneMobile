<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/padGamePanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 右侧列表占内容区 40%，该分界线同时限制顶部搜索区。 -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/padGameListStartGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.6" />

        <FrameLayout
            android:id="@+id/padGameListViewport"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipChildren="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/padGameRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/padGameEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/pad_no_games"
                android:textColor="@color/launcher_text_muted_color"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/padGameLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/pad_loading_games"
                android:textColor="@color/launcher_text_muted_color"
                android:textSize="13sp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/padGameHeader"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@id/padGameListStartGuide"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/padAvatarContainer"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/launcher_avatar"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless">

                    <TextView
                        android:id="@+id/padAvatarInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/launcher_avatar_fallback_initial"
                        android:textColor="@color/launcher_on_primary_color"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/padAvatarImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/home_user_avatar"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/padAccountName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/home_local_player"
                        android:textColor="@color/launcher_text_color"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/padAccountMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/home_local_mode"
                        android:textColor="@color/launcher_text_muted_color"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:layout_weight="1">

                <com.apps.widget.LauncherEditText
                    android:id="@+id/padSearchInput"
                    style="@style/LauncherAddGameInput"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="0dp"
                    android:hint="@string/pad_search_game_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingEnd="48dp" />

                <ImageView
                    android:id="@+id/padSearchIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:contentDescription="@string/pad_search"
                    android:focusable="true"
                    android:src="@drawable/launcher_pad_search_icon" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/padGameShortcutContainer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:padding="10dp"
            app:layout_constraintEnd_toStartOf="@id/padGameListStartGuide"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/padGameHeader">

            <FrameLayout
                android:id="@+id/padGameShortcutOne"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/pad_game_recent_card"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/padGameShowcaseImageOne"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/launcher_game_cover_bg"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/padGameShowcaseOverlayOne"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="@drawable/launcher_game_text_overlay"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/padGameShowcaseTitleOne"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/launcher_text_color"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/padGameShowcaseAddOne"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/pad_showcase_add_symbol"
                    android:textColor="@color/launcher_text_muted_color"
                    android:textSize="32sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/padGameShortcutTwo"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/pad_game_recent_card"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/padGameShowcaseImageTwo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/launcher_game_cover_bg"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/padGameShowcaseOverlayTwo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="@drawable/launcher_game_text_overlay"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/padGameShowcaseTitleTwo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/launcher_text_color"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/padGameShowcaseAddTwo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/pad_showcase_add_symbol"
                    android:textColor="@color/launcher_text_muted_color"
                    android:textSize="32sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/padGameShortcutThree"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/pad_game_recent_card"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/padGameShowcaseImageThree"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/launcher_game_cover_bg"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/padGameShowcaseOverlayThree"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="@drawable/launcher_game_text_overlay"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/padGameShowcaseTitleThree"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/launcher_text_color"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/padGameShowcaseAddThree"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/pad_showcase_add_symbol"
                    android:textColor="@color/launcher_text_muted_color"
                    android:textSize="32sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/padGameShortcutFour"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/pad_game_recent_card"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/padGameShowcaseImageFour"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/launcher_game_cover_bg"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/padGameShowcaseOverlayFour"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="@drawable/launcher_game_text_overlay"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/padGameShowcaseTitleFour"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/launcher_text_color"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/padGameShowcaseAddFour"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/pad_showcase_add_symbol"
                    android:textColor="@color/launcher_text_muted_color"
                    android:textSize="32sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/padGameShortcutFive"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@drawable/pad_game_recent_card"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/padGameShowcaseImageFive"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/launcher_game_cover_bg"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/padGameShowcaseOverlayFive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="@drawable/launcher_game_text_overlay"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/padGameShowcaseTitleFive"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/launcher_text_color"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/padGameShowcaseAddFive"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/pad_showcase_add_symbol"
                    android:textColor="@color/launcher_text_muted_color"
                    android:textSize="32sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- 底部边界：位于底部快捷操作栏上方，左侧详情面板约束到此线，避免越过导航栏。 -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/padDetailBottomGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_end="0dp" />

        <LinearLayout
            android:id="@+id/padGameDetailPanel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:clipToOutline="true"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            app:layout_constraintBottom_toTopOf="@id/padDetailBottomGuide"
            app:layout_constraintEnd_toStartOf="@id/padGameListStartGuide"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/padGameShortcutContainer">

            <LinearLayout
                android:id="@+id/padGameDetailLeft"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="6"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/padStatsCard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/pad_game_recent_card"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/padStatsImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/launcher_home_stats_bg" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/padStatsScrim"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/launcher_home_stats_scrim" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_game_count"
                            android:textColor="@color/launcher_on_primary_color"
                            android:textSize="8sp" />

                        <TextView
                            android:id="@+id/padTvGameCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="0"
                            android:textColor="@color/launcher_on_primary_color"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_total_playtime"
                                    android:textColor="@color/launcher_on_primary_color"
                                    android:textSize="8sp" />

                                <TextView
                                    android:id="@+id/padTvTotalPlayTime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:text="0s"
                                    android:textColor="@color/launcher_on_primary_color"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_today_playtime"
                                    android:textColor="@color/launcher_on_primary_color"
                                    android:textSize="8sp" />

                                <TextView
                                    android:id="@+id/padTvTodayPlayTime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:text="0s"
                                    android:textColor="@color/launcher_on_primary_color"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/padGameDetailRight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4"
                android:layout_marginStart="5dp"
                android:background="@drawable/pad_game_recent_card"
                android:clipToOutline="true">

                <GridLayout
                    android:id="@+id/padDetailActionsGrid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alignmentMode="alignMargins"
                    android:clipChildren="true"
                    android:clipToPadding="true"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:useDefaultMargins="false">

                    <LinearLayout
                        android:id="@+id/padDetailActionSave"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        android:layout_marginEnd="5dp"
                        android:layout_marginBottom="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:contentDescription="@string/launcher_action_save_slot"
                            android:tint="@color/launcher_text_color"
                            android:src="@drawable/launcher_profile_action_save" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/launcher_action_save_slot"
                            android:textColor="@color/launcher_text_color"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/padDetailActionResources"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        android:layout_marginBottom="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:contentDescription="@string/launcher_action_resources"
                            android:tint="@color/launcher_text_color"
                            android:src="@drawable/launcher_action_resources" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/launcher_action_resources"
                            android:textColor="@color/launcher_text_color"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/padDetailActionToolbox"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        android:layout_marginEnd="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:contentDescription="@string/launcher_action_toolbox"
                            android:tint="@color/launcher_text_color"
                            android:src="@drawable/launcher_action_toolbox" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/launcher_action_toolbox"
                            android:textColor="@color/launcher_text_color"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/padDetailActionCrossSource"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:contentDescription="@string/pad_action_cross_source"
                            android:tint="@color/launcher_text_color"
                            android:src="@drawable/launcher_manage_action_cross_sync" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/pad_action_cross_source"
                            android:textColor="@color/launcher_text_color"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </GridLayout>

                <View
                    android:id="@+id/padDetailHLine"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:alpha="0.5"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    android:background="@drawable/pad_detail_dash" />

                <View
                    android:id="@+id/padDetailVLine"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:alpha="0.5"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    android:background="@drawable/pad_detail_dash" />
            </FrameLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
