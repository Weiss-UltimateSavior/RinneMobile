<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_bg">

    <ScrollView
        android:id="@+id/passwordResetScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="25dp"
            android:paddingEnd="20dp"
            android:paddingBottom="25dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:gravity="center"
                android:text="@string/social_reset_password_title"
                android:textColor="@color/launcher_text_color"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:text="@string/social_registered_email"
                android:textColor="@color/launcher_text_muted_color"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.apps.widget.LauncherEditText
                android:id="@+id/resetEmail"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/launcher_account_input"
                android:hint="@string/social_registered_email_hint"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/launcher_text_color"
                android:textColorHint="@color/launcher_input_hint_color"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/social_verification_code"
                android:textColor="@color/launcher_text_muted_color"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <com.apps.widget.LauncherEditText
                    android:id="@+id/resetVerificationCode"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/launcher_account_input"
                    android:hint="@string/social_verification_code_hint"
                    android:inputType="number"
                    android:maxLength="6"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/launcher_text_color"
                    android:textColorHint="@color/launcher_input_hint_color"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/resetSendCode"
                    style="@style/LauncherInlineActionButton"
                    android:layout_width="106dp"
                    android:layout_marginStart="9dp"
                    android:text="@string/social_action_get_code"
                    />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/social_new_password"
                android:textColor="@color/launcher_text_muted_color"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.apps.widget.LauncherEditText
                android:id="@+id/resetPassword"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/launcher_account_input"
                android:hint="@string/social_new_password_hint"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/launcher_text_color"
                android:textColorHint="@color/launcher_input_hint_color"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/social_confirm_new_password"
                android:textColor="@color/launcher_text_muted_color"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.apps.widget.LauncherEditText
                android:id="@+id/resetConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/launcher_account_input"
                android:hint="@string/social_confirm_new_password_hint"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/launcher_text_color"
                android:textColorHint="@color/launcher_input_hint_color"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/resetSubmit"
                style="@style/LauncherLongActionButton"
                android:layout_marginTop="25dp"
                android:text="@string/social_reset_password"
                />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
