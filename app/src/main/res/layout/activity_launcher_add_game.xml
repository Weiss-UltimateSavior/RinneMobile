<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_bg">

    <ScrollView
        android:id="@+id/addGameScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="31dp"
            android:paddingEnd="20dp"
            android:paddingBottom="25dp">

            <TextView
                android:id="@+id/addGameTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/game_add_title"
                android:textColor="@color/launcher_text_color"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/addGameHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/game_add_subtitle"
                android:textColor="@color/launcher_text_muted_color"
                android:textSize="11sp" />

            <TextView
                style="@style/LauncherAddGameLabel"
                android:layout_marginTop="22dp"
                android:text="@string/game_name_label" />

            <com.apps.widget.LauncherEditText
                android:id="@+id/addGameNameInput"
                style="@style/LauncherAddGameInput"
                android:hint="@string/game_name_hint" />

            <TextView
                style="@style/LauncherAddGameLabel"
                android:text="@string/game_engine_label" />

            <TextView
                android:id="@+id/addGameEngineText"
                style="@style/LauncherAddGameInputText"
                android:text="@string/game_engine_auto" />

            <TextView
                style="@style/LauncherAddGameLabel"
                android:text="@string/game_directory_label" />

            <TextView
                android:id="@+id/addGameDirText"
                style="@style/LauncherAddGameInputText"
                android:text="@string/game_directory_select" />

            <TextView
                style="@style/LauncherAddGameLabel"
                android:text="@string/game_cover_label" />

            <TextView
                android:id="@+id/addGameCoverText"
                style="@style/LauncherAddGameInputText"
                android:text="@string/game_cover_select" />

            <TextView
                style="@style/LauncherAddGameLabel"
                android:text="@string/game_launch_entry_label" />

            <TextView
                android:id="@+id/addGameLaunchTargetInput"
                style="@style/LauncherAddGameInputText"
                android:text="@string/game_launch_file_select" />

            <TextView
                style="@style/LauncherAddGameLabel"
                android:text="GameHub localGameId" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <com.apps.widget.LauncherEditText
                    android:id="@+id/addGameGameHubIdInput"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:background="@drawable/launcher_account_input"
                    android:hint="@string/game_gamehub_id_hint"
                    android:inputType="text"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:textColor="@color/launcher_text_color"
                    android:textColorHint="@color/launcher_input_hint_color"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/addGameImportGameHubShortcut"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_marginStart="7dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/game_gamehub_import_shortcut"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/launcher_import_gamehub_shortcut" />
            </LinearLayout>

            <TextView
                style="@style/LauncherAddGameLabel"
                android:text="@string/game_emulator_package_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <com.apps.widget.LauncherEditText
                    android:id="@+id/addGameEmulatorInput"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:background="@drawable/launcher_account_input"
                    android:hint="@string/game_emulator_package_hint"
                    android:inputType="text"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:textColor="@color/launcher_text_color"
                    android:textColorHint="@color/launcher_input_hint_color"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/addGamePickEmulatorApp"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_marginStart="7dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/game_emulator_app_picker"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/launcher_import_gamehub_shortcut" />
            </LinearLayout>

            <TextView
                style="@style/LauncherAddGameLabel"
                android:text="@string/game_notes_label" />

            <com.apps.widget.LauncherEditText
                android:id="@+id/addGameDescriptionInput"
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/launcher_account_input"
                android:gravity="top"
                android:hint="@string/game_common_optional"
                android:paddingStart="13dp"
                android:paddingTop="11dp"
                android:paddingEnd="13dp"
                android:paddingBottom="11dp"
                android:textColor="@color/launcher_text_color"
                android:textColorHint="@color/launcher_input_hint_color"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/addGameSave"
                style="@style/LauncherLongActionButton"
                android:layout_marginTop="20dp"
                android:text="@string/game_common_save"
                />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
