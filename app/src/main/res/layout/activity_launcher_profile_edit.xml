<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_bg">

    <ScrollView
        android:id="@+id/profileEditScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="25dp"
            android:paddingEnd="20dp"
            android:paddingBottom="25dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_edit_title"
                android:textColor="@color/launcher_text_color"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- 修改用户名 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="@string/profile_change_username"
                android:textColor="@color/launcher_text_color"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/profile_new_username"
                android:textColor="@color/launcher_text_muted_color"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.apps.widget.LauncherEditText
                android:id="@+id/inputNewUsername"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/launcher_account_input"
                android:hint="@string/profile_username_hint"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/launcher_text_color"
                android:textColorHint="@color/launcher_input_hint_color"
                android:textSize="13sp" />

            <!-- 修改密码 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="@string/profile_change_password"
                android:textColor="@color/launcher_text_color"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/profile_old_password"
                android:textColor="@color/launcher_text_muted_color"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.apps.widget.LauncherEditText
                android:id="@+id/inputOldPassword"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/launcher_account_input"
                android:hint="@string/profile_old_password_hint"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/launcher_text_color"
                android:textColorHint="@color/launcher_input_hint_color"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/profile_new_password"
                android:textColor="@color/launcher_text_muted_color"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.apps.widget.LauncherEditText
                android:id="@+id/inputNewPassword"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/launcher_account_input"
                android:hint="@string/profile_password_hint"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/launcher_text_color"
                android:textColorHint="@color/launcher_input_hint_color"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/profile_confirm_new_password"
                android:textColor="@color/launcher_text_muted_color"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.apps.widget.LauncherEditText
                android:id="@+id/inputConfirmNewPassword"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/launcher_account_input"
                android:hint="@string/profile_confirm_password_hint"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/launcher_text_color"
                android:textColorHint="@color/launcher_input_hint_color"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:text="@string/profile_password_relogin_notice"
                android:textColor="@color/launcher_text_muted_color"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btnUpdateUsername"
                    style="@style/LauncherLongActionButton"
                    android:text="@string/profile_change_username"
                    />

                <TextView
                    android:id="@+id/btnUpdatePassword"
                    style="@style/LauncherLongActionButton"
                    android:layout_marginTop="9dp"
                    android:text="@string/profile_change_password"
                    />

                <TextView
                    android:id="@+id/profileEditBack"
                    style="@style/LauncherLongActionButton"
                    android:layout_marginTop="9dp"
                    android:text="@string/settings_back"
                    />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
