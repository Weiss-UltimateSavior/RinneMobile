<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal">

    <com.apps.widget.LauncherManageScrollView
        android:id="@+id/manageScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_manage_title"
                android:textColor="@color/launcher_text_color"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/manageActionList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/actionAddDirectory"
                    style="@style/LauncherManageItem">
                    <ImageView
                        style="@style/LauncherProfileActionIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/launcher_manage_action_add_directory" />
                    <TextView
                        style="@style/LauncherManageTitle"
                        android:text="@string/game_scan_add_directory" />
                    <ImageView
                        style="@style/LauncherManageArrowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/launcher_manage_arrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionScanGame"
                    style="@style/LauncherManageItem">
                    <ImageView
                        style="@style/LauncherProfileActionIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/launcher_manage_action_scan_game" />
                    <TextView
                        style="@style/LauncherManageTitle"
                        android:text="@string/game_scan_title" />
                    <ImageView
                        style="@style/LauncherManageArrowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/launcher_manage_arrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionAddGame"
                    style="@style/LauncherManageItem">
                    <ImageView
                        style="@style/LauncherProfileActionIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/launcher_manage_action_add_game" />
                    <TextView
                        style="@style/LauncherManageTitle"
                        android:text="@string/game_add_title" />
                    <ImageView
                        style="@style/LauncherManageArrowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/launcher_manage_arrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionCloudSync"
                    style="@style/LauncherManageItem">
                    <ImageView
                        style="@style/LauncherProfileActionIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/launcher_manage_action_cloud_sync" />
                    <TextView
                        style="@style/LauncherManageTitle"
                        android:text="@string/game_sync_cloud" />
                    <ImageView
                        style="@style/LauncherManageArrowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/launcher_manage_arrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionCrossSync"
                    style="@style/LauncherManageItem">
                    <ImageView
                        style="@style/LauncherProfileActionIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/launcher_manage_action_cross_sync" />
                    <TextView
                        style="@style/LauncherManageTitle"
                        android:text="@string/game_import_cross_platform" />
                    <ImageView
                        style="@style/LauncherManageArrowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/launcher_manage_arrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionDiagnostics"
                    style="@style/LauncherManageItem">
                    <ImageView
                        style="@style/LauncherProfileActionIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/launcher_manage_action_diagnostics" />
                    <TextView
                        style="@style/LauncherManageTitle"
                        android:text="@string/game_diagnostics_title" />
                    <ImageView
                        style="@style/LauncherManageArrowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/launcher_manage_arrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionMetadataSource"
                    style="@style/LauncherManageItem">
                    <ImageView
                        style="@style/LauncherProfileActionIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/launcher_manage_action_metadata_source" />
                    <TextView
                        style="@style/LauncherManageTitle"
                        android:text="@string/game_manage_cover_settings" />
                    <ImageView
                        style="@style/LauncherManageArrowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/launcher_manage_arrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionKrkrSettings"
                    style="@style/LauncherManageItem">
                    <ImageView
                        style="@style/LauncherProfileActionIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/launcher_manage_action_engine_settings" />
                    <TextView
                        style="@style/LauncherManageTitle"
                        android:text="@string/game_manage_engine_settings" />
                    <ImageView
                        style="@style/LauncherManageArrowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/launcher_manage_arrow" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/game_manage_scan_directories"
                android:textColor="@color/launcher_text_color"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/scanDirectoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/scanDirectoryEmpty"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/launcher_white_card"
                android:gravity="center"
                android:text="@string/game_manage_no_scan_directories"
                android:textColor="@color/launcher_text_muted_color"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/scanResultTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/game_manage_recent_scan_results"
                android:textColor="@color/launcher_text_color"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/scanResultDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/launcher_white_card"
                android:orientation="vertical"
                android:padding="13dp"
                android:visibility="gone" />
        </LinearLayout>
    </com.apps.widget.LauncherManageScrollView>

    <FrameLayout
        android:id="@+id/hdManageDetailContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:layout_weight="2"
        android:background="@drawable/launcher_chat_option_bg"
        android:clipChildren="true"
        android:clipToOutline="true" />
    </LinearLayout>
</FrameLayout>
