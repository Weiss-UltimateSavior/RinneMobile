<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_bg">

    <ScrollView
        android:id="@+id/editScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="31dp"
            android:paddingEnd="20dp"
            android:paddingBottom="25dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/game_edit_title"
                android:textColor="@color/launcher_text_color"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/game_title_label"
                android:textColor="@color/launcher_text_color"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.apps.widget.LauncherEditText
                android:id="@+id/editTitle"
                style="@style/LauncherFormInput"
                android:layout_marginTop="5dp"
                android:hint="@string/game_title_hint"
                android:inputType="text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/game_engine_short_label"
                android:textColor="@color/launcher_text_color"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/editEngineText"
                style="@style/LauncherFormInput"
                android:layout_marginTop="5dp"
                android:ellipsize="middle"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/game_engine_auto"
                android:textColor="@color/launcher_text_muted_color"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/game_emulator_package_label"
                android:textColor="@color/launcher_text_color"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <com.apps.widget.LauncherEditText
                    android:id="@+id/editEmulator"
                    style="@style/LauncherFormInput"
                    android:layout_width="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:hint="@string/game_emulator_package_hint"
                    android:inputType="text" />

                <ImageView
                    android:id="@+id/btnPickEmulatorApp"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_marginStart="7dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/game_emulator_app_picker"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/launcher_import_gamehub_shortcut" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/game_launch_target_label"
                android:textColor="@color/launcher_text_color"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.apps.widget.LauncherEditText
                android:id="@+id/editLaunchTarget"
                style="@style/LauncherFormInput"
                android:layout_marginTop="5dp"
                android:hint="@string/game_directory_target"
                android:inputType="text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="GameHub localGameId"
                android:textColor="@color/launcher_text_color"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <com.apps.widget.LauncherEditText
                    android:id="@+id/editGameHubLocalGameId"
                    style="@style/LauncherFormInput"
                    android:layout_width="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:hint="@string/game_gamehub_edit_hint"
                    android:inputType="text" />

                <ImageView
                    android:id="@+id/btnImportGameHubShortcut"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_marginStart="7dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/game_gamehub_import_shortcut"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/launcher_import_gamehub_shortcut" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/game_description_label"
                android:textColor="@color/launcher_text_color"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.apps.widget.LauncherEditText
                android:id="@+id/editDescription"
                style="@style/LauncherFormMultilineInput"
                android:layout_marginTop="5dp"
                android:hint="@string/game_description_optional"
                android:inputType="textMultiLine"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/game_directory_label"
                android:textColor="@color/launcher_text_color"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/editDir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="middle"
                android:maxLines="2"
                android:text="@string/game_directory_not_selected"
                android:textColor="@color/launcher_text_muted_color"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnPickDirectory"
                style="@style/LauncherLongActionButton"
                android:layout_marginTop="10dp"
                android:contentDescription="@string/game_directory_choose"
                android:text="@string/game_directory_choose"
                />

            <TextView
                android:id="@+id/editCoverStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/game_cover_none"
                android:textColor="@color/launcher_text_color"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPickCover"
                style="@style/LauncherLongActionButton"
                android:layout_marginTop="5dp"
                android:text="@string/game_cover_choose"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btnSave"
                    style="@style/LauncherLongActionButton"
                    android:text="@string/game_common_save"
                    />

                <TextView
                    android:id="@+id/btnCancel"
                    style="@style/LauncherLongActionButton"
                    android:layout_marginTop="9dp"
                    android:text="@string/game_common_cancel"
                    />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
