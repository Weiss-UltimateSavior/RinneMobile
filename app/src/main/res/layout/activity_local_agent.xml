<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_bg"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/agentMessages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none" />

    <LinearLayout
        android:id="@+id/agentEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/agentEmptyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/social_agent_task_title"
            android:gravity="center"
            android:textColor="@color/launcher_text_color"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/agentEmptyDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/social_agent_description"
            android:textColor="@color/launcher_text_muted_color"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/agentTopOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:elevation="6dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/agentTitleBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingStart="13dp"
            android:paddingTop="8dp"
            android:paddingEnd="13dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="34dp"
                android:text="Rinne"
                android:textColor="@color/launcher_on_primary_color"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/agentInfoBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/launcher_white_card"
            android:gravity="center_vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/agentStateLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/social_agent_ready"
                    android:textColor="@color/launcher_text_color"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/agentHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:text="@string/social_agent_configure_hint"
                    android:textColor="@color/launcher_text_muted_color"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/agentStateIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/social_agent_settings"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/launcher_agent_settings" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/agentComposerOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/launcher_bg_color"
        android:elevation="0dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/agentInputThemeBar"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:background="@drawable/launcher_white_card"
            android:elevation="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <com.apps.widget.LauncherEditText
                android:id="@+id/agentInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical|start"
                android:hint="@string/social_agent_instruction_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:maxHeight="28dp"
                android:maxLines="2"
                android:minHeight="14dp"
                android:padding="0dp"
                android:singleLine="false"
                android:textColor="@color/launcher_text_color"
                android:textColorHint="@color/launcher_on_primary_color"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/agentSend"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/social_agent_run_or_stop"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/launcher_ic_send" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
