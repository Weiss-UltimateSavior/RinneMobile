<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_bg">

    <ScrollView
        android:id="@+id/themeMenuScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="25dp"
            android:paddingEnd="20dp"
            android:paddingBottom="25dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_menu_title"
                android:textColor="@color/launcher_text_color"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/freshThemeRow"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/launcher_chat_option_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp">

                <ImageView
                    android:id="@+id/freshThemeIcon"
                    android:layout_width="41dp"
                    android:layout_height="41dp"
                    android:background="@drawable/launcher_round_icon_green"
                    android:clipToOutline="true"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/launcher_theme_default_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/theme_default_display_name"
                        android:textColor="@color/launcher_text_color"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/theme_default_description"
                        android:textColor="@color/launcher_text_muted_color"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/freshThemeCheck"
                    android:layout_width="22dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/launcher_primary_color"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nightThemeRow"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="11dp"
                android:background="@drawable/launcher_chat_option_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp">

                <ImageView
                    android:id="@+id/rinneThemeLogo"
                    android:layout_width="41dp"
                    android:layout_height="41dp"
                    android:background="@drawable/launcher_round_icon_purple"
                    android:clipToOutline="true"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/launcher_theme_rinne_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/theme_rinne_display_name"
                        android:textColor="@color/launcher_text_color"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/theme_rinne_description"
                        android:textColor="@color/launcher_text_muted_color"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/nightThemeCheck"
                    android:layout_width="22dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/launcher_primary_color"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pinkThemeRow"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="11dp"
                android:background="@drawable/launcher_chat_option_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp">

                <ImageView
                    android:id="@+id/anriThemeLogo"
                    android:layout_width="41dp"
                    android:layout_height="41dp"
                    android:background="@drawable/launcher_round_icon_pink"
                    android:clipToOutline="true"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/launcher_theme_anri_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/theme_anri_display_name"
                        android:textColor="@color/launcher_text_color"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/theme_anri_description"
                        android:textColor="@color/launcher_text_muted_color"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/pinkThemeCheck"
                    android:layout_width="22dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/launcher_primary_color"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/xinhaitianThemeRow"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="11dp"
                android:background="@drawable/launcher_chat_option_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp">

                <ImageView
                    android:id="@+id/xinhaitianThemeLogo"
                    android:layout_width="41dp"
                    android:layout_height="41dp"
                    android:clipToOutline="true"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/launcher_theme_xinhaitian_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/theme_xinhaitian_display_name"
                        android:textColor="@color/launcher_text_color"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/theme_xinhaitian_description"
                        android:textColor="@color/launcher_text_muted_color"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/xinhaitianThemeCheck"
                    android:layout_width="22dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/launcher_primary_color"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/natsumeThemeRow"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="11dp"
                android:background="@drawable/launcher_chat_option_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp">

                <ImageView
                    android:id="@+id/natsumeThemeLogo"
                    android:layout_width="41dp"
                    android:layout_height="41dp"
                    android:clipToOutline="true"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/launcher_theme_natsume_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/theme_natsume_display_name"
                        android:textColor="@color/launcher_text_color"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/theme_natsume_description"
                        android:textColor="@color/launcher_text_muted_color"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/natsumeThemeCheck"
                    android:layout_width="22dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/launcher_primary_color"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/particleToggleRow"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="11dp"
                android:background="@drawable/launcher_chat_option_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp">

                <TextView
                    android:id="@+id/particleToggleIcon"
                    android:layout_width="41dp"
                    android:layout_height="41dp"
                    android:gravity="center"
                    android:text="P"
                    android:textColor="@color/launcher_on_primary_color"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/theme_dynamic_particles"
                        android:textColor="@color/launcher_text_color"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/theme_particles_description"
                        android:textColor="@color/launcher_text_muted_color"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/particleToggleState"
                    android:layout_width="52dp"
                    android:layout_height="31dp"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="25dp" />

            <TextView
                android:id="@+id/themeMenuApply"
                style="@style/LauncherLongActionButton"
                android:text="@string/theme_apply"
                />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
